#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1

apply_state() {
	local enabled

	enabled="$(uci -q get mosdns-ui.settings.enabled)"
	if [ "$enabled" = "1" ]; then
		/etc/init.d/mosdns enable >/dev/null 2>&1 || true
		/etc/init.d/mosdns restart >/dev/null 2>&1 || true
	else
		/etc/init.d/mosdns stop >/dev/null 2>&1 || true
		/etc/init.d/mosdns disable >/dev/null 2>&1 || true
	fi
}

start_service() {
	apply_state
}

reload_service() {
	apply_state
}

service_triggers() {
	procd_add_reload_trigger mosdns-ui
}
